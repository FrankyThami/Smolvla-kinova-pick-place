<mujoco model="pick_place_scene">
  <!-- Kinova Gen3 (7-joint model from MuJoCo Menagerie) + Robotiq 2F-85 gripper -->
  <include file="gen3_robotiq.xml"/>

  <statistic center="0.45 0 0.1" extent="1.0"/>

  <visual>
    <headlight diffuse="0.25 0.25 0.25" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="145" elevation="-25"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0.4 0 2.0" dir="0 0 -1" directional="true" diffuse="0.55 0.55 0.55" specular="0.05 0.05 0.05"/>
    <light name="side_light" pos="1.2 -1.0 1.5" dir="-0.5 0.5 -0.7" directional="true" diffuse="0.25 0.25 0.25" specular="0 0 0"/>

    <geom name="floor" type="plane" pos="0 0 -0.75" size="0 0 0.05" material="groundplane"/>

    <!-- Table: top surface is at z = 0. The robot base sits on it at the origin. -->
    <body name="table" pos="0.35 0 -0.02">
      <geom name="table_top" type="box" size="0.6 0.6 0.02" rgba="0.30 0.33 0.38 1" friction="1 0.005 0.0001"/>
      <geom name="table_leg_1" type="box" size="0.03 0.03 0.355" pos="0.55 0.55 -0.375" rgba="0.3 0.3 0.3 1"/>
      <geom name="table_leg_2" type="box" size="0.03 0.03 0.355" pos="0.55 -0.55 -0.375" rgba="0.3 0.3 0.3 1"/>
      <geom name="table_leg_3" type="box" size="0.03 0.03 0.355" pos="-0.55 0.55 -0.375" rgba="0.3 0.3 0.3 1"/>
      <geom name="table_leg_4" type="box" size="0.03 0.03 0.355" pos="-0.55 -0.55 -0.375" rgba="0.3 0.3 0.3 1"/>
    </body>

    <!-- Empty marker body: the "front" camera looks at it -->
    <body name="workspace_center" pos="0.45 0 0.04"/>

    <!-- Cameras (the "wrist" camera is defined on the arm itself) -->
    <camera name="top" pos="0.45 0 0.85" xyaxes="0 -1 0 1 0 0" fovy="60"/>
    <camera name="front" pos="1.1 0 0.55" mode="targetbody" target="workspace_center" fovy="60"/>

    <!-- The yellow cube (4 cm). It has a free joint, so it can be pushed, lifted and dropped. -->
    <body name="cube" pos="0.45 -0.15 0.02">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.02 0.02 0.02" mass="0.05" rgba="1 0.9 0.05 1"
        friction="1 0.005 0.0001"/>
    </body>

    <!-- The yellow box (open top). Inner opening is 15 cm x 15 cm, walls are 4 cm high.
         It is a "mocap" body, so Python can move it to a new place every episode. -->
    <body name="box" mocap="true" pos="0.45 0.15 0">
      <geom name="box_floor" type="box" size="0.085 0.085 0.005" pos="0 0 0.005" rgba="0.95 0.72 0.0 1"/>
      <geom name="box_wall_px" type="box" size="0.005 0.085 0.02" pos="0.08 0 0.03" rgba="0.95 0.72 0.0 1"/>
      <geom name="box_wall_nx" type="box" size="0.005 0.085 0.02" pos="-0.08 0 0.03" rgba="0.95 0.72 0.0 1"/>
      <geom name="box_wall_py" type="box" size="0.075 0.005 0.02" pos="0 0.08 0.03" rgba="0.95 0.72 0.0 1"/>
      <geom name="box_wall_ny" type="box" size="0.075 0.005 0.02" pos="0 -0.08 0.03" rgba="0.95 0.72 0.0 1"/>
    </body>
  </worldbody>
</mujoco>
